{
  "name": "douyu-keep",
  "version": "3.10.0",
  "description": "斗鱼粉丝牌保活工具，it just works.",
  "author": "tophtab",
  "contributors": [
    {
      "name": "Curtion"
    }
  ],
  "license": "UNLICENSED",
  "repository": "https://github.com/KNaiFen/douyu-keep.git",
  "main": "build/docker/desktop/main.js",
  "scripts": {
    "lint": "eslint \"src/**/*.{js,ts,vue}\" \"test/**/*.js\" eslint.config.mjs",
    "type-check": "npm run type-check:docker && npm run type-check:webui && npm run type-check:desktop",
    "type-check:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "type-check:docker": "tsc -p tsconfig.docker.json --noEmit",
    "type-check:webui": "vue-tsc -p tsconfig.webui.json --noEmit",
    "test:contracts": "node --test test/*.test.js",
    "test": "npm run test:contracts && npm run build:docker",
    "build": "npm run build:docker",
    "build:webui": "npm run type-check:webui && vite build",
    "build:docker": "node scripts/clean-build.cjs && npm run build:webui && tsc -p tsconfig.docker.json",
    "build:desktop": "npm run build:docker && tsc -p tsconfig.desktop.json",
    "setup:desktop": "node node_modules/electron/install.js",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:installer": "node scripts/smoke-installer.cjs",
    "dev:desktop": "npm run setup:desktop && npm run build:desktop && electron .",
    "start:desktop": "npm run setup:desktop && electron .",
    "pack:win": "npm run build:desktop && electron-builder --win --x64 --dir",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "start": "node build/docker/docker/index.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cron": "^4.4.0",
    "cron-parser": "^5.5.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "vue-tsc": "^3.2.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  }
}
