{
  "appId": "io.github.knaifen.douyu-keep",
  "productName": "douyu-keep",
  "directories": { "output": "release", "buildResources": "packaging/windows" },
  "files": ["build/docker/**/*", "package.json", "icon.png", "LICENSE"],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "icon": "icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }]
  },
  "artifactName": "douyu-keep-${version}-windows-${arch}.${ext}",
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "include": "packaging/windows/installer.nsh"
  }
}
